*.local.db
*.local.sqlite
*.local.sqlite3
*.local.sqlite-journal
*.local.sqlite-wal
*.local.sqlite-shm
*.local.sqlite3-journal
*.local.sqlite3-wal
*.local.sqlite3-shm
/pgdata/
/data/postgres/
/data/local/
/backups/local/

# Private fixtures and uploaded files (not shared test fixtures)
/tests/fixtures/private/
/data/private/
/uploads/
/backend/uploads/

